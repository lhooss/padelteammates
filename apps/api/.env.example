# --- Server ---
NODE_ENV=development
# 3001 : le port 3000 est deja pris sur la machine de dev
PORT=3001

# --- Database (PostgreSQL) ---
# Le docker-compose fourni expose Postgres sur le port hote 5433
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/padel_teamates?schema=public"

# --- Redis (sessions de match actives) ---
REDIS_URL="redis://localhost:6379"

# --- Auth (JWT) ---
JWT_SECRET="change-me-in-production-please-use-a-long-random-string"
# Jeton d'acces court, renouvele en silence par le jeton de session longue.
JWT_EXPIRES_IN="15m"
# Duree d'une session d'appareil (jours) avant reconnexion obligatoire.
REFRESH_TOKEN_DAYS="60"

# --- Envoi d'emails (mot de passe oublie) ---
# Cle d'API Resend. Sans elle, l'API fonctionne mais n'envoie aucun email :
# le code de reinitialisation est alors journalise (pratique en developpement).
# RESEND_API_KEY=""
# Expediteur. Tant que le domaine n'est pas verifie chez Resend, garder le
# domaine de test : "Padelteammates <onboarding@resend.dev>"
EMAIL_FROM="Padelteammates <onboarding@resend.dev>"

# --- CORS ---
# Vide = toutes les origines, ce qui convient a une app mobile native.
# A renseigner si une version web est publiee, ex. "https://app.padelteammates.ma"
# CORS_ORIGIN=""

# --- Bootstrap admin (utilise par prisma/seed.ts) ---
ADMIN_EMAIL="admin@padelteammates.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Admin Kenitra"
