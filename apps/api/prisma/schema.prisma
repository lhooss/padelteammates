// Padel App v0 - schema relationnel
// Voir SDD: User / Club / Match / Participant / Score (+ Notification in-app)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum MatchStatus {
  PLANNED // cree, joueurs invites
  PENDING // score saisi, en attente de validation (>= 2/4)
  COMPLETED // verrouille
}

enum Team {
  A
  B
}

// Qui voit le match, au choix de l'organisateur. Ses joueurs le voient toujours.
enum MatchVisibility {
  PUBLIC // toute la communaute
  FRIENDS // les amis de l'organisateur
  PRIVATE // les joueurs du match uniquement
}

enum PresenceStatus {
  INVITED
  CONFIRMED
}

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String
  role         Role    @default(USER)

  // Stats globales (mises a jour apres validation d'un score)
  profilePublic Boolean @default(false)
  wins          Int     @default(0)
  losses        Int     @default(0)

  // Profil padel (modifiable par le joueur). Le telephone n'est visible que de ses amis.
  preferredSide CourtSide?
  level         PlayerLevel?
  dominantHand  Hand?
  phone         String? // format +212XXXXXXXXX
  homeClubId    String?
  homeClub      Club?        @relation("HomeClub", fields: [homeClubId], references: [id], onDelete: SetNull)

  createdMatches Match[]        @relation("CreatedBy")
  participations Participant[]
  notifications  Notification[]
  refreshTokens  RefreshToken[]
  pushTokens     PushToken[]

  friendRequestsSent     Friendship[] @relation("FriendRequestsSent")
  friendRequestsReceived Friendship[] @relation("FriendRequestsReceived")
  joinRequests           JoinRequest[]
  frmtLink               FrmtLink?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Appareil sur lequel un joueur recoit les notifications push (jeton Expo).
// Un meme jeton ne peut appartenir qu'a un compte : en cas de changement de
// compte sur le telephone, il est reattribue.
model PushToken {
  id       String @id @default(cuid())
  token    String @unique
  platform String // "android" | "ios"

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Session longue d'un appareil. Seule l'empreinte du jeton est stockee, et chaque
// rafraichissement la remplace : un jeton ne sert qu'une fois (rotation).
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

enum FriendshipStatus {
  PENDING // demande envoyee, en attente de reponse
  ACCEPTED // amis (relation symetrique)
}

// Amitie entre deux joueurs, creee par le demandeur. Le service garantit une seule
// ligne par paire, dans les deux sens. On n'invite a un match que ses amis (ACCEPTED).
model Friendship {
  id     String           @id @default(cuid())
  status FriendshipStatus @default(PENDING)

  requesterId String
  requester   User   @relation("FriendRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)

  addresseeId String
  addressee   User   @relation("FriendRequestsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

model Club {
  id   String @id @default(cuid())
  name String
  city String @default("Kénitra")
  // Un club ferme est desactive, jamais supprime : les matchs deja joues le gardent.
  // Un club inactif n'est plus propose (calendrier, planification, club habituel).
  active Boolean @default(true)

  matches Match[]
  members User[]  @relation("HomeClub") // joueurs dont c'est le club habituel

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, city])
}

// --- Profil padel ---

enum CourtSide {
  LEFT
  RIGHT
  BOTH
}

enum PlayerLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum Hand {
  RIGHT
  LEFT
}

model Match {
  id         String          @id @default(cuid())
  date       DateTime // jour du match (minuit UTC)
  slot       String // creneau, ex: "18:00-19:30"
  status     MatchStatus     @default(PLANNED)
  visibility MatchVisibility @default(PUBLIC)

  clubId String
  club   Club   @relation(fields: [clubId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  participants Participant[]
  score        Score?
  joinRequests JoinRequest[]

  // Reservation du terrain, faite aupres du club (hors de l'app) et confirmee ici
  // par n'importe quel joueur du match. null = terrain pas encore reserve.
  courtBookedAt   DateTime?
  courtBookedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Pas de contrainte d'unicite sur (club, jour, creneau) : un club a plusieurs
  // terrains, plusieurs matchs peuvent donc partager le meme creneau.
  @@index([date])
}

// Demande d'un joueur pour rejoindre un match (depuis le calendrier), dans une equipe
// ayant une place libre. Supprimee a l'acceptation (le joueur devient participant),
// au refus ou a l'annulation.
model JoinRequest {
  id   String @id @default(cuid())
  team Team

  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([matchId, userId])
  @@index([userId])
}

model Participant {
  id             String         @id @default(cuid())
  team           Team
  presenceStatus PresenceStatus @default(INVITED)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, matchId])
  @@index([matchId])
}

model Score {
  id String @id @default(cuid())

  matchId String @unique
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  // Composition finale + detail des sets, valide par Zod avant insertion.
  // Forme: { teams: { A: string[], B: string[] }, games: [{ sets: [{a,b}] }] }
  setsDetail  Json
  gamesPlayed Int
  winningTeam Team?

  // userIds ayant approuve la saisie. Verrouillage quand length >= 2.
  validators  String[] @default([])
  enteredById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id      String  @id @default(cuid())
  type    String // INVITE | SCORE_ENTERED | SCORE_VALIDATED | MATCH_COMPLETED
  message String
  read    Boolean @default(false)
  matchId String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, read])
}

// --- Classement national padel de la FRMT ---

enum FrmtCategory {
  MEN
  WOMEN
}

enum FrmtLinkStatus {
  PENDING // demande du joueur, en attente de l'admin
  VERIFIED // valide par l'admin
}

// Une ligne du classement publie par la FRMT, importee periodiquement (chaque import
// remplace toutes les lignes). La FRMT ne publie pas d'identifiant stable : un joueur
// s'identifie par son nom (tel que publie) et son annee de naissance.
model FrmtRankingEntry {
  id          String       @id @default(cuid())
  category    FrmtCategory
  rank        Int
  evolution   Int? // places gagnees (+) ou perdues (-) ; null si inchange
  fullName    String // "NOM PRENOM"
  birthYear   Int?
  club        String? // code club FRMT, ex. "COC"
  nationality String?
  points      Float
  importedAt  DateTime     @default(now())

  @@index([category, rank])
  @@index([fullName])
}

// Lien entre un joueur de l'app et sa ligne du classement FRMT, valide par l'admin.
// Il porte l'identite FRMT (et non l'id d'une ligne) pour survivre aux imports.
model FrmtLink {
  id         String         @id @default(cuid())
  userId     String         @unique
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   FrmtCategory
  fullName   String
  birthYear  Int?
  status     FrmtLinkStatus @default(PENDING)
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Historique des imports : dates, volumes, erreur eventuelle (page FRMT modifiee...).
model FrmtImport {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  menCount   Int       @default(0)
  womenCount Int       @default(0)
  error      String?
}
