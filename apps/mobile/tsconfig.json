{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Remplace (et non etend) la liste de expo/tsconfig.base : on garde "react-native"
    // et on resout @padelteammates/shared sur ses sources TS.
    "customConditions": ["react-native", "@padelteammates/source"],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
