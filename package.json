{
  "name": "padelteammates",
  "version": "0.1.0",
  "private": true,
  "description": "Padel App v0 - monorepo : API backend, app mobile (a venir) et schemas partages",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @padelteammates/api",
    "mobile": "npm run start -w @padelteammates/mobile",
    "build": "npm run build -w @padelteammates/shared && npm run build -w @padelteammates/api",
    "start": "npm run start -w @padelteammates/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present --",
    "prisma:generate": "npm run prisma:generate -w @padelteammates/api",
    "prisma:migrate": "npm run prisma:migrate -w @padelteammates/api --",
    "prisma:deploy": "npm run prisma:deploy -w @padelteammates/api",
    "prisma:studio": "npm run prisma:studio -w @padelteammates/api",
    "seed": "npm run seed -w @padelteammates/api",
    "seed:prod": "npm run seed:prod -w @padelteammates/api",
    "frmt:import": "npm run frmt:import -w @padelteammates/api"
  },
  "engines": {
    "node": ">=20"
  }
}
